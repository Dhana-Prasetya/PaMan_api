generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username       String           @unique @db.VarChar(20)
  phone_number   String           @unique @db.VarChar(20)
  email          String           @unique @db.VarChar(255)
  password       String           @db.VarChar(255)
  gender         gender_enum
  role           String           @db.VarChar(10)
  avatar_url     String?          @db.VarChar(255)
  register_date  DateTime?        @default(now()) @db.Timestamptz(6)
  birthday       DateTime?        @db.Date
  temp_token     String?          @db.VarChar(300)
  fullname       String           @db.VarChar(255)
  carts          carts?
  orders         orders[]
  product_review product_review[]
  user_address   user_address[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id               Int                   @id @default(autoincrement())
  name             String                @unique @db.VarChar(255)
  stock            Int
  price            Int
  photo_url        String                @db.VarChar(255)
  description      String                @db.VarChar(4000)
  category         product_category_enum
  discounted_price Int?
  total_reviews    Int?                  @default(0)
  average_rating   Decimal?              @default(0.0) @db.Decimal(2, 1)
  carts_items      carts_items[]
  ordered_item     ordered_item[]
  product_review   product_review[]
}

model admin {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username      String    @unique @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  role          String    @db.VarChar(10)
  avatar_url    String?   @db.VarChar(255)
  register_date DateTime? @default(now()) @db.Timestamptz(6)
  temp_token    String?   @db.VarChar(300)
}

model contact {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username String @db.VarChar(255)
  email    String @db.VarChar(255)
  message  String @db.VarChar(800)
}

model user_address {
  id             Int      @id @default(autoincrement())
  user_id        String   @db.Uuid
  street         String   @db.VarChar(255)
  kecamatan      String   @db.VarChar(255)
  city           String   @db.VarChar(100)
  province       String   @db.VarChar(100)
  postal_code    String   @db.VarChar(5)
  is_default     Boolean? @default(false)
  recipient_name String   @db.VarChar(50)
  detail         String?  @db.VarChar(255)
  orders         orders[]
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ordered_item {
  id             Int      @id @default(autoincrement())
  order_id       Int
  product_id     Int
  quantity       Int
  price_at_order Int
  orders         orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products       products @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@unique([order_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id           Int               @id @default(autoincrement())
  user_id      String            @db.Uuid
  order_date   DateTime?         @default(now()) @db.Timestamptz(6)
  total_price  Int
  order_status order_status_enum
  destination  Int
  ordered_item ordered_item[]
  user_address user_address      @relation(fields: [destination], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users             @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  payments     payments[]
}

model carts {
  id          Int           @id @default(autoincrement())
  user_id     String        @unique @db.Uuid
  users       users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carts_items carts_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carts_items {
  id         Int      @id(map: "cart_item_pkey") @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_item_carts_id_fkey")
  products   products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "cart_item_product_id_fkey")

  @@unique([cart_id, product_id], map: "cart_item_carts_id_product_id_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id             String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id       Int
  transaction_id String              @unique @default(dbgenerated("('COD'::text || (nextval('payment_cash_seq'::regclass))::text)")) @db.VarChar(255)
  payment_method payment_method_enum
  amount_paid    Int
  payment_status payment_status_enum
  created_at     DateTime?           @default(now()) @db.Timestamptz(6)
  amount_to_pay  Int
  orders         orders              @relation(fields: [order_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_review {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    String   @db.Uuid
  review     String?  @db.VarChar(4000)
  rating     Int
  products   products @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, product_id])
}

enum gender_enum {
  Laki
  Perempuan
  Rahasia
}

enum order_status_enum {
  Belum_Bayar         @map("Belum Bayar")
  Dikemas
  Dikirim
  Selesai
  Menunggu_Konfirmasi @map("Menunggu Konfirmasi")
  Ditolak
  Diterima
}

enum payment_method_enum {
  COD
  Midtrans
}

enum payment_status_enum {
  Sukses
  Proses
  Gagal
}

enum product_category_enum {
  Beras
  Sayur
  Buah
}
