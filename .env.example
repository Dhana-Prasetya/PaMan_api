BACKEND_RUNNING_PORT=your_running_port # Port number for the Express server to run
PG_USER=your_db_user # PostgreSQL database username
PG_HOST=your_host # PostgreSQL database host
PG_DB_NAME=your_db_name # PostgreSQL database name  
PG_PASSWORD=your_db_password # PostgreSQL database password
PG_PORT=your_db_port # PostgreSQL database port

SECRET_KEY_JWT=your_jwt_secret_key # Secret key for JWT authentication

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret